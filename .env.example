# ==============================================================================
# QWSC Environment Variables Example
# ==============================================================================
# Copy this file to `.env` or `.env.local` and customize for your environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# Prisma connection string (SSL mode required for hosted DBs like Neon/Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qwsc?schema=public

# ------------------------------------------------------------------------------
# 2. Application Runtime Environment
# ------------------------------------------------------------------------------
# Values: development | test | production
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. Authentication & Security Secrets
# ------------------------------------------------------------------------------
# Secrets used for JWT signing and session cookies.
# MUST be set to strong, unique strings (min 32 characters) in production!
JWT_SECRET=dev_jwt_secret_change_in_production_min_32_chars!
COOKIE_SECRET=dev_cookie_secret_change_in_production_min_32_chars!

# ------------------------------------------------------------------------------
# 4. Google OAuth 2.0 / OIDC Credentials
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Used for backend token verification, OAuth exchange, and automatically served
# to the frontend Google Sign-In button via /api/v1/auth/google/config:
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder

# ------------------------------------------------------------------------------
# 5. Networking & Security Policies (Optional)
# ------------------------------------------------------------------------------
# Base URL for API requests (defaults to same-origin relative URLs if omitted):
# NEXT_PUBLIC_API_URL=http://localhost:3000

# Comma-separated list of additional trusted origins allowed for CSRF checks:
# ALLOWED_ORIGINS=http://localhost:3000,https://qwsc.example.com
